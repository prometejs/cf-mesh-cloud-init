# CI render fixture for .github/workflows/validate.yml.
# Drives scripts/render-userdata.sh against cloud-init/user-data.tpl so the
# workflow can run `cloud-init schema` against real rendered output.
# All values are dummy — never put real secrets here.

HOSTNAME="ci-validation"
ANSIBLE_SSH_PUBKEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAFAKEKEYFORCI ci@validation"

# Required by render-userdata.sh's require() checks. The current template
# does not reference these placeholders, so substitution is a no-op.
WARP_TUNNEL_TOKEN="dummy.fixture.token"
