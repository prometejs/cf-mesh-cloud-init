# dnsmasq PXE config — single source of truth.
# Rendered to /etc/dnsmasq.d/pxe.conf by scripts/bootstrap-provisioner.sh, with
# the {{...}} placeholders filled from flags. To use manually, copy this file,
# replace the {{...}} placeholders with your values, and drop it in
# /etc/dnsmasq.d/.

# Listen only on the PXE network interface
interface={{IFACE}}
bind-interfaces
domain-needed
bogus-priv

# DHCP scope for the PXE network
dhcp-range={{DHCP_RANGE}}
# router
dhcp-option=3,{{GATEWAY}}
# dns
dhcp-option=6,{{DNS}}

# TFTP root (serves iPXE binaries to legacy PXE clients)
enable-tftp
tftp-root=/srv/tftp

# Tags any client that includes DHCP option 175 as ipxe
dhcp-match=set:ipxe,175

# UEFI vs BIOS detection
dhcp-match=set:bios,option:client-arch,0
dhcp-match=set:uefi,option:client-arch,7
dhcp-match=set:uefi,option:client-arch,9

# Two-stage PXE: send iPXE binary on first try, then iPXE script on second
# Stage 1: BIOS PXE → undionly.kpxe ; UEFI → ipxe.efi
dhcp-boot=tag:!ipxe,tag:bios,undionly.kpxe
dhcp-boot=tag:!ipxe,tag:uefi,ipxe.efi
# Stage 2: iPXE has loaded; send it to our HTTP boot script
dhcp-boot=tag:ipxe,http://{{IP}}/boot.ipxe

log-dhcp
