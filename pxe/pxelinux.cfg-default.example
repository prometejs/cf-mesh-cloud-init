# /srv/tftp/pxelinux.cfg/default — legacy BIOS PXELINUX menu.
# Modern flow chainloads iPXE; this is here only as a fallback.

DEFAULT cf-cloud-init
TIMEOUT 50
PROMPT 0

LABEL cf-cloud-init
  KERNEL ubuntu/22.04/vmlinuz
  APPEND initrd=ubuntu/22.04/initrd ip=dhcp autoinstall ds=nocloud-net;s=http://10.0.10.10/seed/default/
