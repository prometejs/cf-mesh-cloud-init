# /etc/seed-server.env — environment for seed-server.service
# Copy to /etc/seed-server.env (chmod 0640, owned root:seed-server) and edit.

# ---- State source (required) ----
S3_BUCKET=tf-prometejs-state-bucket
S3_KEY=cloudflare-infra/dev/terraform.tfstate
S3_REGION=eu-west-2

# ---- AWS credentials ----
# Leave commented out to use the running environment's defaults:
#   - IAM instance/role profile (EC2)
#   - ~/.aws/credentials for the seed-server user
#   - AWS_* already in the daemon's environment
# Set explicitly only if none of the above apply.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---- Template values (required for any {{VAR}} the template uses) ----
# Fleet-wide ansible automation user SSH public key
ANSIBLE_SSH_PUBKEY=ssh-ed25519 AAAA...replace... ansible@fleet

# ---- Tuning (defaults shown — uncomment to override) ----
# Apache talks to us via localhost; never expose Python directly to the LAN.
BIND_HOST=127.0.0.1
BIND_PORT=8080

# Cache lifetime for the S3 state fetch, in seconds.
# Bump for big fleets / quiet S3; lower for fast iteration during a TF apply.
CACHE_TTL=120

# Dot-path under .outputs in the TF state (rarely needs changing)
INVENTORY_KEY=site_inventory.value
